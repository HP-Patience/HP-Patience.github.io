{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/widget/heatmap.json",
    "description": "Activity heatmap widget configurations",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "const": "heatmap",
            "nullable": true
        },
        "title": {
            "type": "string",
            "description": "Widget title",
            "default": "Activity",
            "nullable": true
        }
    },
    "required": [
        "type"
    ]
}
